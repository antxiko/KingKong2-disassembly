L 0xBCAA iconos_de_shot2
L 0xBCD3 pinta_los_iconos_de_la_lista
L 0xBD1E sitio_del_cursor
L 0xBD24 pon_si_no_es_cero
L 0xBD63 pinta_los_zuecos
L 0xBD8D cursor_de_la_ventana
L 0xBF68 dieciseis_bytes
L 0xBE3D pon_c800_delante_de_mitchel
C 0xBE3D la posicion de 0xC800 a 0x10 de Mitchel, hacia donde mira

