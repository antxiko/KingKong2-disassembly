# Notas del banco 00: comentarios (C), etiquetas (L) y datos (D) anclados a direccion.

# --- A MANO: comentarios, nombres y bloques (cada uno de lo que hace ESE codigo) ---
L 0x4068 puente_da_un_objeto
C 0x4068 p01:79CE: da el objeto A, una unidad (lo usan las conversaciones de p12)
L 0x4176 puente_da_objeto_b
C 0x4176 p01:79D0: da el objeto A, B unidades (al recogerlo del suelo, p09:BC03)
L 0x419A puente_pon_objeto
C 0x419A p01:7852: pone el objeto C (B unidades) en (E, D) de la pantalla
L 0x4AE5 sube_iconos_y_hoja_comun
L 0x4AED sube_los_38_iconos
B 0x4AED Los 38 dibujos de los objetos, 16x16 a 4 bits (128 bytes cada uno), de
B 0x4AED p07:630A a la VRAM 0xB800: la pagina 1 desde la linea 0x70, 16 por fila.
B 0x4AED El objeto n es el dibujo n-1 (p01:7962).
C 0x4AF3 38 dibujos
L 0x48D0 sube_dibujos_de_16
C 0x48D4 el siguiente, 16 puntos (8 bytes) a la derecha
C 0x48D7 al llegar a 0x80 (256 puntos), 16 lineas mas abajo
D 0x4014 0x4050 gm_resto  0xFF en las banderas (el Game Master no toma ningun campo) y 59 bytes que no lee nada de este cartucho: direcciones de su RAM (0xC100, 0xC104, 0xC120-0xC121, 0xC116, las del sonido 0xC01A-0xC096) y 0x66D8, la tabla de piezas de p04
D 0x405C 0x4062 puente_405C  un puente que no usa nadie: call 0x4919 / jp 0x4215
D 0x40AA 0x40B0 puente_40AA  un puente que no usa nadie: call 0x6433 / jp 0x4215
D 0x4194 0x419A puente_4194  un puente que no usa nadie: call 0x4EB2 / jp 0x4215
D 0x41BE 0x41C4 puente_41BE  un puente que no usa nadie: call 0x52FF / jp 0x4215
D 0x41D0 0x41D6 puente_41D0  un puente que no usa nadie: call 0x4667 / jp 0x4215
D 0x435D 0x4365 desplazamientos_435D  8 bytes (0, -8, -12 ... -32): lo que p00:4399 resta segun C - 1 y B - 1
D 0x4365 0x437F bufferes_4365  13 palabras, de 0x42 en 0x42 desde 0xD680: la zona de RAM de cada ficha segun ix+0x0F (p00:433A y p00:437F)
D 0x445C 0x446E figura_445C  9 columnas x 2 filas de numeros de dibujo (0xD0-0xE1) que p00:4450 pinta en (8, 0xB0)
D 0x459F 0x45AD codigo_459F  codigo que no llama nadie: escribe A en la VRAM de HL (p00:45AD y el puerto de 0x0007)
D 0x4FC4 0x4FD0 figura_4FC4  4 columnas x 3 filas de numeros de dibujo (0xE2-0xEA) que p00:4FBB pinta donde dice su ficha
D 0x56F3 0x5704 lista_de_sprites_7  lista de patrones de sprite 7 de p00:5630: no la pide ninguna pantalla (p09:B0B7 no da el 7)
D 0x580C 0x5811 lista_de_sprites_20  lista de patrones de sprite 20 de p00:5630: tampoco la pide ninguna pantalla
L 0x4255 hl_mas_a
L 0x425A de_mas_a
L 0x425F despacha
B 0x425F Salta a la entrada A de la tabla de palabras que va pegada detras del `call`.
L 0x4260 despacha_hl
L 0x42BC bancos_1_2_3
L 0x42C2 bancos_4_5_6
L 0x42DE bancos_7_8_9
L 0x42E4 bancos_10_11_12
L 0x42EA bancos_13_14_15
L 0x42C6 pon_tres_bancos
L 0x42F0 escribe_has_cogido
C 0x42F0 el nombre del objeto A en (0x10, 0xB8) y "を とりました。" detras
L 0x42FF palabra_de_la_tabla
C 0x42FF DE = la palabra A de la tabla de DE
L 0x4308 posicion_de_mitchel
C 0x4308 E = la y de Mitchel, D = su x
L 0x431F casilla_en_ram
C 0x431F HL = la casilla de 8x8 del punto (L, H) en el mapa de la RAM (0xE000, 32 por fila)
L 0x4399 esquina_de_la_ficha
L 0x43B8 casilla_de_la_ficha
L 0x437F repinta_el_fondo_de_la_ficha
L 0x441F escribe_nombre_de_objeto
C 0x441F el nombre del objeto A (p15:A069 + 2*A) en HL
L 0x440C escribe_nombre_de_la_casilla
L 0x4430 sitio_de_la_casilla
L 0x456B cuenta_para_otir
L 0x4573 copia_a_la_vram
C 0x4573 BC bytes de HL a la VRAM de DE
L 0x4586 rellena_la_vram
C 0x4586 BC bytes con A desde la VRAM de HL
L 0x45AD vram_para_escribir
C 0x45AD prepara el V9938 para escribir en la direccion de VRAM HL (R#14 y el puerto 1)
L 0x45CC vram_para_leer
L 0x4558 lee_de_la_vram
L 0x45E9 rle_con_destino
C 0x45E9 la palabra de DE es la direccion de VRAM; detras, el RLE
L 0x45EF rle_a_la_vram
C 0x45EF el RLE de DE a la VRAM de HL (n con el bit 7: n bytes tal cual; sin el, repetir; 0 acaba)
L 0x4612 limpia_la_pantalla
L 0x4620 enciende_la_pantalla
C 0x4620 bit 6 del registro 1 del VDP a uno
L 0x462D apaga_la_pantalla
C 0x462D bit 6 del registro 1 del VDP a cero
L 0x4651 oculta_los_sprites
C 0x4651 los 128 bytes de atributos de sprite (0xF600) a 0xE0
L 0x4672 pon_un_color
C 0x4672 color A de la paleta = D (RB) y E (G)
L 0x469C paleta_inicial
C 0x469C los 16 colores de p00:46AF
L 0x46CF pon_paleta
C 0x46CF lista [color][RB][G] ... 0xFF
L 0x46DD espera_al_vdp
C 0x46DD espera a que el V9938 acabe la orden (bit 0 de S#2)
L 0x46E6 lee_estado_del_vdp
C 0x46E6 lee el registro de estado A del V9938
L 0x476D marco
C 0x476D cuatro rayas: un marco de E por D en HL
L 0x479B hmmv
C 0x479B orden HMMV del V9938: rellena BxC puntos en (H, L) de la pagina D con A
L 0x47D7 hmmm
C 0x47D7 orden HMMM del V9938: copia BxC puntos de (H, L) a (D, E); A lleva las paginas
L 0x481B lmmm
C 0x481B orden LMMM del V9938: lo mismo con operacion logica (A: paginas y operacion; 8 = TIMP)
L 0x4867 sube_letras
C 0x4867 B letras de 1 bit de HL, en color C, a la hoja de la pagina 1 desde (D, E)
L 0x4870 sube_una_letra
L 0x4891 sube_un_dibujo
C 0x4891 un dibujo de 8x8 a 4 bits (32 bytes) de HL a la VRAM de DE
L 0x48A6 sube_dibujos
C 0x48A6 B dibujos de 8x8 a 4 bits de HL a la VRAM de DE
L 0x48BB sube_un_dibujo_de_16
L 0x48E5 expande_letra
C 0x48E5 una letra de 1 bit a 4 bits, en 0xE800, con el color C
L 0x490F rotulo
C 0x490F [x][y] letras, 0xFE [x][y] otro sitio, 0xFF acaba
L 0x4915 rotulo_en_color
L 0x4919 escribe_letras
L 0x492B pinta_lista_de_dibujos
C 0x492B numeros de dibujo; 0xFE, otra fila; 0xFF acaba
L 0x4952 escribe_una_letra
L 0x497B pon_dibujo
C 0x497B el dibujo A de la hoja (pagina 1) en (D, E) de la pagina 0
L 0x498D pon_dibujo_transparente
C 0x498D lo mismo con LMMM + TIMP: el color 0 no pinta
L 0x499F copia_dibujo_en_la_hoja
L 0x49B1 copia_8x8_en_la_hoja
L 0x49C0 sitio_del_dibujo
C 0x49C0 H = (A & 31)*8, L = (A >> 5)*8: donde esta el dibujo A en la hoja
L 0x49CE siguiente_sitio
C 0x49CE D + 8; al dar la vuelta, E + 8
L 0x49D8 sube_la_hoja_de_la_pantalla
L 0x4A1B sube_dibujos_volteados
L 0x4A7B sube_la_hoja
C 0x4A7B el juego de dibujos de la pantalla (0xC148) y su lista de subida
L 0x4AF8 pon_bancos_del_juego
L 0x4B15 sube_los_juegos_de_jefe
L 0x4B5E recompone_jefe
L 0x4B85 recompone_cuartos
L 0x4B9D invierte_16_bytes
L 0x4BB4 rle_a_la_ram
C 0x4BB4 el RLE de HL a la RAM de DE
L 0x4BD0 figuras_a_pelo
L 0x4C92 sube_sprites_4C92
L 0x4CB3 sube_los_sprites_de_la_pantalla
L 0x4CEC bancos_del_nibble
C 0x4CEC el nibble alto de A elige el trio de bancos (0 1-2-3, 1 4-5-6, 2 7-8-9, 3 10-11-12, si no 13-14-15)
L 0x4D43 lee_patrones
L 0x4D52 escribe_patrones
L 0x4D62 bytes_de_los_patrones
C 0x4D62 BC = ix+3 * 32
L 0x4D6F direccion_del_patron
C 0x4D6F HL = 0xF800 + 8*L
L 0x4D79 espejo_de_patrones
L 0x4DA9 volteo_de_patrones
